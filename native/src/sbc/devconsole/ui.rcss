/* Port of LuaUI/rmlui/dbg_dev_console.css. */

/* Screen-sized so the console can be positioned against it, but click-through:
   only the console itself takes pointer events. */
body {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	font-family: Poppins;
	pointer-events: none;
}

/* Sits to the left of the 500dp native panel, as in the Lua console. */
#dev-console {
	position: absolute;
	left: 0dp;
	right: 500dp;
	bottom: 80dp;
	height: 300dp;
	color: #c8d0e0;
	background-color: #1a1d219e;
	border-width: 1dp;
	border-color: #000000;
	display: flex;
	flex-direction: column;
	pointer-events: auto;
}

#dev-console.hidden {
	display: none;
}

.header {
	display: flex;
	flex-direction: row;
	gap: 8dp;
	align-items: baseline;
	padding: 4dp 8dp;
}

.header .title {
	font-size: 18dp;
	font-weight: bold;
	color: #eef1ff;
}

.error-count {
	font-size: 13dp;
	color: #f2686c;
}

.log-container {
	flex: 1 1 auto;
	overflow-y: auto;
	overflow-x: hidden;
	padding: 4dp 8dp;
	font-size: 13dp;
}

.log-line {
	display: block;
	white-space: pre-wrap;
	padding: 1dp 0dp;
}

.log-line.severity-info {
	color: #c8d0e0;
}

.log-line.severity-warning {
	color: #e8c46a;
}

.log-line.severity-error {
	color: #f2686c;
}

.log-line.selected {
	background-color: #335f78;
	color: #ffffff;
}

.toolbar {
	display: flex;
	flex-direction: row;
	gap: 5dp;
	padding: 7dp 8dp;
	border-top-width: 1dp;
	border-top-color: #000000;
}

/* `flex: 1` is what makes the buttons share the toolbar's width evenly, as the
   Lua console's do; without it they shrink to their text and read as cramped. */
.toolbar button {
	flex: 1;
	min-height: 30dp;
	padding: 6dp 12dp;
	text-align: center;
	letter-spacing: 0.05em;
	font-size: 13dp;
	color: #c8d0e0;
	background-color: #1c1d20;
	border-width: 1dp;
	border-color: #2a2b2e;
	border-radius: 2dp;
}

.toolbar button:hover {
	background-color: #2a2b2e;
	color: #d4d8df;
}

.toolbar button.toggle {
	padding-left: 16dp;
	background-color: #212528;
	color: #cfd4db;
	border-left-width: 6dp;
	border-left-color: #2e2f32;
	border-radius: 5dp;
	font-weight: bold;
}

.toolbar button.toggle:hover {
	background-color: #2a2e32;
	color: #e1e5eb;
	border-left-color: #4a4d52;
}

.toolbar button.pressed {
	background-color: #18241b;
	color: #79e68c;
	border-left-width: 6dp;
	border-left-color: #397848;
}

.toolbar button.toggle.pressed:hover {
	background-color: #1f3425;
	color: #9efca6;
	border-left-color: #5fc878;
}

scrollbarvertical {
	width: 10dp;
	background-color: #1c1f24;
}

scrollbarvertical sliderbar {
	background-color: #44484e;
	border-radius: 3dp;
}

scrollbarvertical sliderbar:hover {
	background-color: #5fc878;
}
