/* Port of LuaUI/rmlui/dbg_dev_console.css. */

/* Screen-sized so the console can be positioned against it, but click-through:
   only the console itself takes pointer events. */
body {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	font-family: Poppins;
	pointer-events: none;
}

/* Sits to the left of the 500dp native panel, as in the Lua console. */
#dev-console {
	position: absolute;
	left: 0dp;
	right: 500dp;
	bottom: 80dp;
	height: 300dp;
	color: #c8d0e0;
	background-color: #1a1d219e;
	border-width: 1dp;
	border-color: #000000;
	display: flex;
	flex-direction: column;
	pointer-events: auto;
}

#dev-console.hidden {
	display: none;
}

.header {
	display: flex;
	flex-direction: row;
	gap: 8dp;
	align-items: baseline;
	padding: 4dp 8dp;
}

.header .title {
	font-size: 18dp;
	font-weight: bold;
	color: #eef1ff;
}

.error-count {
	font-size: 13dp;
	color: #f2686c;
}

.log-container {
	flex: 1 1 auto;
	overflow-y: auto;
	overflow-x: hidden;
	padding: 4dp 8dp;
	font-size: 13dp;
}

.log-line {
	display: block;
	white-space: pre-wrap;
	padding: 1dp 0dp;
}

.log-line.severity-info {
	color: #c8d0e0;
}

.log-line.severity-warning {
	color: #e8c46a;
}

.log-line.severity-error {
	color: #f2686c;
}

.toolbar {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 4dp;
	padding: 6dp 8dp;
	border-top-width: 1dp;
	border-top-color: #000000;
}

.toolbar button {
	padding: 4dp 8dp;
	font-size: 12dp;
	color: #c8d0e0;
	background-color: #2a2f36;
	border-width: 1dp;
	border-color: #454b54;
	border-radius: 3dp;
}

.toolbar button:hover {
	background-color: #3a4049;
}

.toolbar button.pressed {
	background-color: #5fc878;
	color: #10140f;
}

scrollbarvertical {
	width: 10dp;
	background-color: #1c1f24;
}

scrollbarvertical sliderbar {
	background-color: #44484e;
	border-radius: 3dp;
}

scrollbarvertical sliderbar:hover {
	background-color: #5fc878;
}
