<div id="editor-status" data-model="editor_status">
	<div id="status-info" class="theme-surface-muted theme-framed">
		<div id="status-position" class="status-line">{{ position }}</div>
		<div id="status-performance" class="status-line">
			<span id="status-performance-0" class="status-metric normal"><span class="metric-label">FPS</span><span class="metric-value">{{ fps }}</span></span>
			<span id="status-performance-1" class="status-metric normal"><span class="metric-label">Process CPU</span><span class="metric-value">{{ process_cpu }}</span></span>
			<span id="status-performance-2" class="status-metric normal"><span class="metric-label">System CPU</span><span class="metric-value">{{ system_cpu }}</span></span>
		</div>
		<div id="status-system" class="status-line">
			<span id="status-system-0" class="status-metric normal"><span class="metric-label">Lua</span><span class="metric-value">{{ lua_memory }}</span></span>
			<span id="status-system-1" class="status-metric normal"><span class="metric-label">VRAM</span><span class="metric-value">{{ vram }}</span></span>
			<span id="status-system-2" class="status-metric normal"><span class="metric-label">RAM</span><span class="metric-value">{{ ram }}</span></span>
			<span id="status-system-3" class="status-metric normal"><span class="metric-label">Process RAM</span><span class="metric-value">{{ process_memory }}</span></span>
		</div>
		<div id="status-version" class="status-line">{{ version }}</div>
	</div>
	<div id="command-status" class="theme-surface-muted theme-framed">
		<div id="command-toolbar" class="command-toolbar">
			<button id="status-undo" class="status-icon-button" title="Undo (Ctrl+Z)"><img src="LuaUI/images/scenedit/anticlockwise-rotation.png"/></button>
			<button id="status-redo" class="status-icon-button" title="Redo (Ctrl+Y)"><img src="LuaUI/images/scenedit/clockwise-rotation.png"/></button>
			<button id="status-clear" class="status-icon-button" title="Clear undo-redo stack"><img src="LuaUI/images/scenedit/cancel.png"/></button>
		</div>
		<div id="command-list" class="command-list theme-inset">
			<div data-for="command : command_history" class="command-item">{{ command.text }}</div>
		</div>
	</div>
</div>
