<button data-model="panel_editor_buttons" data-for="editor : editors" data-if="editor.visible" class="editor-button" data-attr-title="editor.tooltip" data-class-pressed="editor.pressed" data-class-disabled="editor.disabled">
    <img data-attr-src="editor.icon"/>
    <div class="editor-button-label">{{ editor.label }}</div>
</button>
