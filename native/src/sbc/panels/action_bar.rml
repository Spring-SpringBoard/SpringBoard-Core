<button data-model="panel_action_bar" data-for="action : actions" data-if="action.visible" class="action-button" data-attr-title="action.tooltip" data-class-pressed="action.pressed" data-class-disabled="action.disabled" data-event-click="select(it_index)" data-event-mouseover="show_tooltip(it_index)" data-event-mouseout="hide_tooltip(it_index)">
    <img data-attr-src="action.icon"/>
</button>
