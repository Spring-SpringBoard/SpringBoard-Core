/* Top-left project status bar: the project location plus the always-available
   Open Project / Data Dir / Upload Log / Exit actions. A screen-edge surface
   pinned to the top-left corner, over the map. */
.project-status-float {
    position: absolute;
    left: 8dp;
    top: 8dp;
    width: 420dp;
    background-color: #2a2a2ae0;
    border: 1dp #555555;
    border-radius: 4dp;
    padding: 6dp 8dp;
    /* Only the buttons take clicks; the rest of the corner passes through to
       the map underneath, the way the notifications strip does. */
    pointer-events: none;
}

.project-status-label {
    display: block;
    color: #c8d0e0;
    font-size: 13dp;
    margin-bottom: 6dp;
}

.project-status-buttons {
    display: block;
}

.project-status-btn {
    display: inline-block;
    margin-right: 5dp;
    padding: 4dp 9dp;
    color: #ffffff;
    font-size: 12dp;
    background-color: #3a3f4b;
    border: 1dp #555555;
    border-radius: 3dp;
    pointer-events: auto;
}

.project-status-btn:hover {
    background-color: #4a5160;
}

.project-status-btn.danger {
    background-color: #6a2a2a;
}

.project-status-btn.danger:hover {
    background-color: #8a3535;
}
