/* The panel is positioned against the body, so the body must span the screen;
   with an auto-sized body an absolutely-positioned child collapses. */
body {
    font-family: Poppins;
    font-size: 12dp;
    color: #cccccc;
    background-color: transparent;
    margin: 0;
    padding: 0;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* Geometry mirrors scen_edit/view/rcss/springboard.rcss so the native panel is
   in the same place, at the same size, as the two Lua ones. */
#native-panel {
    position: absolute;
    right: 0dp;
    top: 0dp;
    width: 500dp;
    height: 100%;
    background-color: #1f26219e;
}

/* --- Tab bar --- */
.tab-bar {
    position: absolute;
    top: 10dp;
    left: 0dp;
    right: 0dp;
    height: 40dp;
    background-color: #1c211e;
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.tab-button {
    width: 70dp;
    height: 40dp;
    flex-shrink: 0;
    background-color: #111411;
    color: #999999;
    border-color: #555555;
    padding: 2dp 6dp;
    font-size: 12dp;
    /* Do not use flex on a text-bearing element: RmlUi will not render the raw
       text node inside a flex container. */
    text-align: center;
    line-height: 36dp;
}

.tab-button:hover {
    background-color: #202820;
    color: #cccccc;
}

.tab-button.active {
    background-color: #050705;
    color: #ffffff;
    border-color: #5d7190;
}

/* --- Action bar (toolbar) --- */
.action-bar {
    position: absolute;
    top: 130dp;
    left: 0dp;
    right: 0dp;
    height: 40dp;
    display: flex;
    flex-direction: row;
    gap: 1dp;
    padding: 0dp 5dp;
    align-items: center;
}

/* --- Editor button strip --- */
.editor-button-panel {
    position: absolute;
    top: 55dp;
    left: 0dp;
    right: 0dp;
    height: 80dp;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 1dp;
    padding: 5dp;
    overflow-x: auto;
    overflow-y: hidden;
}

.editor-button {
    width: 70dp;
    height: 70dp;
    background-color: #111411;
    border-color: #2e342f;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3dp;
    flex-shrink: 0;
}

.editor-button:hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.editor-button.pressed {
    background-color: #050705;
    border-color: #00ff00;
}

.editor-button img {
    width: 35dp;
    height: 35dp;
    margin-bottom: 4dp;
}

.editor-button-label {
    font-size: 11dp;
    color: #cccccc;
    text-align: center;
}

.editor-button.pressed .editor-button-label {
    color: #00ff00;
}

/* --- Editor content host --- */
.main-content {
    position: absolute;
    top: 175dp;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    padding: 0dp 10dp;
    color: #cccccc;
    overflow-y: auto;
}

/* --- Fields ---------------------------------------------------------------
   Ported verbatim from scen_edit/view/rcss/fields.rcss so the native panel is
   visually identical to the Lua RmlUi one. Keep the two in sync.
--------------------------------------------------------------------------- */

/* Common Field Styles - used across dialogs, editors, and floating windows */

.field-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    /* Wrap instead of clipping: grouped numeric fields (X/Y/Z) are wider than
       the 500px panel and the last column was cut off. */
    flex-wrap: wrap;
    margin-bottom: 8px;
    gap: 10px;
    min-height: 31px;
}

.field-row.hidden {
    display: none;
}

.hidden {
    display: none;
}

.field-inline {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
}

/* Size to the label text: a fixed 44px clipped longer captions ("Emission"). */
.field-inline .field-label {
    width: auto;
    min-width: 44px;
    margin-right: 4px;
    flex-shrink: 0;
    color: #cccccc;
    font-size: 12px;
}

.field-inline .field-input {
    width: 66px;
    height: 26px;
    flex-shrink: 0;
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    padding: 3px 6px;
    font-size: 12px;
}

.field-label {
    width: 112px;
    flex-shrink: 0;
    color: #cccccc;
    font-size: 12px;
}

.field-input {
    width: 126px;
    height: 26px;
    flex-shrink: 0;
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    padding: 3px 6px;
    font-size: 12px;
}

.field-input:focus {
    border-color: #5d7190;
    background-color: #151a16;
}

.field-checkbox {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 6px;
    cursor: pointer;
    background-color: #3a3a3a;
    border: 1px #555555;
    border-radius: 3px;
}

.field-checkbox:hover {
    border-color: #8a8a8a;
}

.field-checkbox:checked {
    background-color: #3a7ebf;
    border-color: #2a5f8f;
}

/* Asset/material picker buttons. Styled like the other field buttons rather
   than as a blue primary button, which read as a bare blue bar when empty. */
.field-button {
    width: 140px;
    min-height: 31px;
    flex-shrink: 0;
    background-color: #111411;
    color: #eeeeee;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 8px;
    font-size: 12px;
    text-align: left;
    line-height: 27px;
}

.field-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-button:active {
    border-color: #999999;
}

.field-color-button {
    width: 140px;
    height: 31px;
    flex-shrink: 0;
    color: #ffffff;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 5px;
    font-size: 12px;
}

.field-color-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-color-button:active {
    border-color: #999999;
}

.field-numeric-button,
.field-numeric-input {
    background-color: #111411;
    border: 2px #050706;
    border-radius: 4px;
    color: #ffffff;
}

.field-numeric-button {
    height: 31px;
    padding: 0px 8px;
}

.field-numeric-button:hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.field-numeric-button:active,
.field-numeric-button.dragging {
    color: #f5d316;
    border-color: #b19c24;
    background-color: #171a12;
}

.field-numeric-input {
    padding: 3px 8px;
    text-align: right;
}

.field-composite-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background-color: #111411;
    color: #eeeeee;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 8px;
    min-height: 31px;
}

.field-composite-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-button-title {
    color: #eeeeee;
    font-size: 12px;
    text-align: left;
}

.field-button-value {
    color: #d9d9d9;
    font-size: 12px;
    text-align: right;
}

.field-swatch {
    width: 18px;
    height: 18px;
    border: 2px #050706;
    flex-shrink: 0;
}

.field-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin: 10px 0px 7px 0px;
}

.field-section-label {
    color: #d7d7d7;
    font-size: 12px;
    flex-shrink: 0;
}

.field-section-line {
    width: 100px;
    height: 1px;
    background-color: #377987;
}

/* Grid Container - for asset/material browsers */
.grid-container {
    border: 1px #555555;
    border-radius: 3px;
    background-color: #1a1a1a;
    overflow-y: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 5px;
    gap: 5px;
}

.grid-container.hidden {
    display: none;
}

/* Grid Item. Width/height come from the renderer (itemWidth/itemHeight) as
   inline styles; the cell itself is image box + label in normal flow. */
.grid-item {
    border: 1px #444444;
    border-radius: 2px;
    cursor: pointer;
    background-color: #2a2a2a;
    overflow: hidden;
}

.grid-item:hover {
    border-color: #777777;
}

/* Colour only: changing border-width on selection resizes the cell and
   reflows/shifts the whole grid. */
.grid-item.selected {
    border-color: #3a7ebf;
}

/* RCSS has no !important, and `.hidden` (one class) ties with the rules above
   that set `display` (e.g. .field-composite-button { display: flex }), which
   then win by declaration order. These compound selectors raise specificity so
   hiding actually hides -- notably the numeric field's button, which otherwise
   stays visible next to its edit box. */
.field-composite-button.hidden,
.field-numeric-button.hidden,
.field-numeric-input.hidden,
.field-input.hidden {
    display: none;
}

/* Icon-only field button (remove-rule etc.) */
.field-icon-button img {
    width: 16px;
    height: 16px;
}

/* Progress bar (map compile) */
.field-progress {
    position: relative;
    width: 160px;
    height: 30px;
    background-color: #1a1a1a;
    border-width: 1px;
    border-color: #555555;
}

.field-progress-fill {
    height: 100%;
    background-color: #3a7fbf;
}

.field-progress-caption {
    position: absolute;
    left: 0;
    top: 6px;
    width: 100%;
    text-align: center;
    color: #e0e0e0;
}

/* Grouped fields laid out side by side (Lua's GroupField). From
   scen_edit/view/rcss/springboard.rcss. */
.field-group {
    display: flex;
    flex-direction: row;
    /* Wrap instead of clipping: grouped fields can be wider than the panel. */
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
    align-items: center;
}

/* A field inside a group must not also carry the row's bottom margin. */
.field-group .field-row {
    margin-bottom: 0px;
}

/* --- Select popup (RmlUi has no `selectoption` element: options are `option`
   inside `selectbox`, and the selected one carries :checked) --- */
.select-wrapper {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.select-arrow {
    position: absolute;
    right: 6px;
    color: #888888;
    font-size: 8px;
}

selectvalue {
    background-color: transparent;
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
}

selectbox {
    background-color: #0a0a0f;
    color: #ffffff;
    border: 2px #2e342f;
    margin-top: 2px;
    max-height: 200px;
    overflow-y: auto;
    z-index: 1000;
}

selectbox option {
    background-color: #111411;
    color: #ffffff;
    padding: 6px 10px;
    display: block;
    min-height: 24px;
}

selectbox option:hover,
selectbox option:focus {
    background-color: #202820;
}

selectbox option:checked {
    background-color: #1a2a3a;
    color: #8ab4ff;
}

/* --- Scrollbars --- */
scrollbarhorizontal,
scrollbarhorizontal slidertrack,
scrollbarhorizontal sliderbar,
scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    display: none;
}

scrollbarvertical {
    width: 8px;
    background-color: #1a1a1a;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}

scrollbarvertical slidertrack {
    margin-left: 1px;
    width: 6px;
    background-color: #121315;
}

scrollbarvertical sliderbar {
    width: 6px;
    min-height: 20px;
    background-color: #44484e;
}

scrollbarvertical sliderbar:hover {
    background-color: #5fc878;
}
