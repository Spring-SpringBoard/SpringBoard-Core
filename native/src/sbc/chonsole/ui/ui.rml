<div id="native-chonsole" data-model="chonsole">
    <div id="native-chonsole-lines" class="lines">
        <div data-for="line : lines" class="line output-line" data-class-input-line="line.muted">{{ line.text }}</div>
    </div>
    <div id="native-chonsole-suggestions" class="suggestions theme-surface" data-class-hidden="suggestions_hidden">
        <div data-for="suggestion : suggestions" data-if="suggestion.visible" class="suggestion" data-class-selected-suggestion="suggestion.selected" data-class-hovered-suggestion="suggestion.highlighted">
            <span class="suggestion-command">{{ suggestion.label }}</span>
            <span class="suggestion-description">{{ suggestion.detail }}</span>
        </div>
    </div>
    <div id="native-chonsole-suggestion-details" class="suggestion-details theme-surface" data-class-hidden="suggestions_hidden">
        <span class="suggestion-details-command">{{ detail_command }}</span>
        <span class="suggestion-details-text"> {{ detail_text }}</span>
    </div>
    <div id="native-chonsole-input" class="input-row theme-surface">
        <span class="prompt">&gt;</span><span class="input">{{ input_before }}</span><span class="cursor" data-if="cursor_before_selection">&nbsp;</span><span class="input selection" data-if="has_selection">{{ input_selection }}</span><span class="cursor" data-if="cursor_after_selection">&nbsp;</span><span class="input">{{ input_after }}</span>
    </div>
</div>
