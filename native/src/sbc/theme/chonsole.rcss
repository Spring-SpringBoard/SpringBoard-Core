body {
    position: absolute;
    left: 26%;
    top: 24.5%;
    width: 41%;
    height: 47%;
    color: #f2f7fc;
    font-effect: shadow(1px 1px #000000);
    background-color: transparent;
    border-width: 0dp;
}

#native-chonsole {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 0dp;
    bottom: 0dp;
    padding: 0dp;
}

.lines {
    display: none;
    height: 0dp;
    padding: 0dp;
    font-size: 0dp;
    line-height: 0dp;
}

.line {
    display: block;
    margin-bottom: 2dp;
}

.input-line {
    color: #eef4fb;
}

.output-line {
    color: #c9d4df;
}

.error-line {
    color: #ff6f6f;
}

.suggestions {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 38dp;
    height: 380dp;
    padding: 4dp 0dp 0dp 0dp;
    font-size: 16dp;
    line-height: 27dp;
    color: #e5eef7;
    overflow-y: auto;
    overflow-x: hidden;
}

.suggestion {
    display: block;
    position: relative;
    height: 27dp;
    padding: 0dp;
    background-color: transparent;
    white-space: nowrap;
    overflow: hidden;
}

.selected-suggestion {
    background-color: #4f9ed1c0;
}

.suggestion:hover {
    background-color: #2b5878d8;
}

.suggestion-command {
    position: absolute;
    left: 8dp;
    right: 50%;
    top: 0dp;
    height: 27dp;
    line-height: 27dp;
    white-space: nowrap;
    overflow: hidden;
    color: #ffffff;
}

.suggestion-description {
    position: absolute;
    left: 51%;
    right: 14dp;
    top: 0dp;
    height: 27dp;
    line-height: 27dp;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    color: #d5e3f0;
}

.suggestion-details {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 424dp;
    height: 54dp;
    padding: 5dp 10dp;
    font-size: 14dp;
    line-height: 18dp;
    color: #dce8f3;
    border-top-width: 1dp;
    border-top-color: #29465f;
    white-space: normal;
    overflow: hidden;
}

.suggestion-details-command {
    color: #ffffff;
    font-weight: bold;
}

.suggestion-details-text {
    color: #d5e3f0;
}

.input-row {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 0dp;
    height: 36dp;
    padding: 5dp 8dp;
    font-size: 22dp;
    line-height: 26dp;
    color: #ffffff;
    white-space: pre;
    overflow: hidden;
}

.prompt {
    color: #dce3ea;
    margin-right: 6dp;
}

.input {
    color: #f3f7fb;
}

.selection {
    color: #ffffff;
    background-color: #6aa8ff88;
}

.cursor {
    display: inline-block;
    position: relative;
    width: 2dp;
    height: 22dp;
    margin-right: -2dp;
    overflow: hidden;
    vertical-align: middle;
    color: #e6e6e6aa;
    background-color: #e6e6e6aa;
}
