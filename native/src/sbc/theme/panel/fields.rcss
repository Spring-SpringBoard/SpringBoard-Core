/* --- Fields ---------------------------------------------------------------
   Ported verbatim from scen_edit/view/rcss/fields.rcss so the native panel is
   visually identical to the Lua RmlUi one. Keep the two in sync.
--------------------------------------------------------------------------- */

/* Common Field Styles - used across dialogs, editors, and floating windows */

.field-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    /* Wrap instead of clipping: grouped numeric fields (X/Y/Z) are wider than
       the 500px panel and the last column was cut off. */
    flex-wrap: wrap;
    margin-bottom: 8px;
    gap: 10px;
    min-height: 31px;
    width: 100%;
}
.field-row.hidden {
    display: none;
}

.hidden {
    display: none;
}

.field-inline {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
}

/* Size to the label text: a fixed 44px clipped longer captions ("Emission"). */
.field-inline .field-label {
    width: auto;
    min-width: 44px;
    margin-right: 4px;
    flex-shrink: 0;
    color: #cccccc;
    font-size: 12px;
}

.field-inline .field-input {
    width: 66px;
    height: 26px;
    flex-shrink: 0;
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    padding: 3px 6px;
    font-size: 12px;
}

.field-label {
    width: 112px;
    flex-shrink: 0;
    color: #cccccc;
    font-size: 12px;
}

.field-input {
    width: 126px;
    height: 26px;
    flex-shrink: 0;
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    padding: 3px 6px;
    font-size: 12px;
    box-sizing: border-box;
}

/* A normal row has one full-width control. Give every control the same zero
   flex basis so legacy preferred widths cannot misalign adjacent rows.
   Grouped rows are converted to `.field-inline` below and split evenly. */
.field-row > .field-input,
.field-row > .field-composite-button,
.field-row > .field-button,
.field-row > .select-wrapper,
.field-row > .field-toggle {
    flex: 1 1 0dp;
    min-width: 0dp;
}

.field-input:focus {
    border-color: #5d7190;
    background-color: #151a16;
}

.field-toggle {
	width: 200dp;
	min-height: 31px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	gap: 10px;
	padding: 0px 11px;
	cursor: pointer;
	text-align: left;
    border: 2px #050706;
    border-left-width: 6px;
    border-radius: 5px;
	font-size: 13px;
    box-sizing: border-box;
}

.field-toggle-label {
	flex-grow: 1;
	font-weight: bold;
}

/* Chili's BooleanField is a balanced 200px toggle button. It is not a full
   form row; only a group deliberately spreads controls across the row. */
.field-row.field-boolean > .field-toggle {
	flex: 0 0 200dp;
	width: 200dp;
}

/* Asset/material picker buttons. Styled like the other field buttons rather
   than as a blue primary button, which read as a bare blue bar when empty. */
.field-button {
    width: 140px;
    min-height: 31px;
    flex-shrink: 0;
    background-color: #111411;
    color: #eeeeee;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 8px;
    font-size: 12px;
    text-align: left;
    line-height: 27px;
    box-sizing: border-box;
}

.field-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-button:active {
    border-color: #999999;
}

.field-color-button {
    /* A colour field is a proper form control, not a fixed-width swatch. This
       lets a standalone picker use the form width and lets grouped pickers
       share their column evenly with numeric fields and toggles. */
    width: 100%;
    height: 31px;
    min-width: 0dp;
    color: #ffffff;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 5px;
    font-size: 12px;
    box-sizing: border-box;
}

.field-color-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-color-button:active {
    border-color: #999999;
}

.field-numeric-button,
.field-numeric-input,
.field-string-button,
.field-string-input {
    background-color: #111411;
    border: 2px #050706;
    border-radius: 4px;
    color: #ffffff;
}

.field-numeric-button {
    height: 31px;
    padding: 0px 8px;
    /* Opt into RmlUi's drag: it captures the pointer, so `dragend` arrives
       wherever the button is released -- including outside the panel, where the
       engine never tells us anything (its RmlUi consumes the press before the
       event clients, so no mouse_release is ever delivered for a field). */
    drag: drag;
}

.field-string-button {
    height: 31px;
}

.field-numeric-button:hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.field-numeric-button:active,
.field-numeric-button.dragging {
    color: #f5d316;
    border-color: #b19c24;
    background-color: #171a12;
}

.field-numeric-input,
.field-string-input {
    padding: 3px 8px;
    text-align: right;
}

.field-composite-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background-color: #111411;
    color: #eeeeee;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 8px;
    min-height: 31px;
    box-sizing: border-box;
}

.field-composite-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.shading-texture-button {
    width: 290px;
}

.shading-enabled {
    color: #63d483;
}

.shading-disabled {
    color: #ef6b6b;
}

.shading-dialog-actions {
    display: flex;
    flex-direction: row;
    gap: 8px;
    margin-bottom: 10px;
}

/* `.hidden` is declared earlier in the sheet, so this flex display would win
   the cascade and the source-choice row could never be hidden. */
.shading-dialog-actions.hidden {
    display: none;
}

.field-button-title {
    color: #eeeeee;
    font-size: 12px;
    text-align: left;
    min-width: 0dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.field-button-value {
    color: #d9d9d9;
    font-size: 12px;
    text-align: right;
    flex-shrink: 0;
}

/* The colour is conveyed by a consistently sized swatch, so compact grouped
   pickers still read as colour controls rather than ordinary text buttons. */
.field-swatch {
    display: block;
    width: 20px;
    height: 18px;
    flex: 0 0 20px;
    border: 2px #050706;
    border-radius: 3px;
    box-sizing: border-box;
}

.field-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin: 10px 0px 7px 0px;
}

.field-section-label {
    color: #d7d7d7;
    font-size: 12px;
    flex-shrink: 0;
}

.field-section-line {
    width: 100px;
    height: 1px;
    background-color: #377987;
}

/* RCSS has no !important, and `.hidden` (one class) ties with the rules above
   that set `display` (e.g. .field-composite-button { display: flex }), which
   then win by declaration order. These compound selectors raise specificity so
   hiding actually hides -- notably the numeric field's button, which otherwise
   stays visible next to its edit box. */
/* Icon-only field button (remove-rule etc.) */
.field-icon-button img {
    width: 16px;
    height: 16px;
}

/* Progress bar (map compile) */
.field-progress {
    position: relative;
    width: 160px;
    height: 30px;
    background-color: #1a1a1a;
    border-width: 1px;
    border-color: #555555;
}

.field-progress-fill {
    height: 100%;
    background-color: #3a7fbf;
}

.field-progress-caption {
    position: absolute;
    left: 0;
    top: 6px;
    width: 100%;
    text-align: center;
    color: #e0e0e0;
}

/* Grouped fields laid out side by side (Lua's GroupField). From
   scen_edit/view/rcss/springboard.rcss. */
.field-group {
    display: flex;
    flex-direction: row;
    /* Three compact X/Y/Z fields fit on one line; unusually wide entries may
       still wrap rather than clipping. */
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
    align-items: center;
}

/* A field inside a group must not also carry the row's bottom margin. */
.field-group .field-row {
    margin-bottom: 0px;
}

.field-group .field-inline.field-boolean {
    /* In a group, a toggle is a peer of the other controls: a numeric/toggle
       or colour/toggle pair therefore has two equal, aligned columns. */
    flex: 1 1 0dp;
    min-width: 0dp;
    width: 100%;
}

.field-group .field-inline.field-boolean-long {
    flex-basis: 100%;
}

/* Property/collision vector groups use the available panel width evenly;
   three X/Y/Z controls no longer huddle in the first 60% of the row. */
.field-group .field-inline {
    flex: 1 1 0dp;
    min-width: 0dp;
}

.field-group .field-inline .field-input,
.field-group .field-inline .field-composite-button,
.field-group .field-inline .select-wrapper,
.field-group .field-inline.field-boolean > .field-toggle {
    flex: 1 1 0dp;
    min-width: 0dp;
    width: 100%;
}

.field-row > .color-field,
.field-group .field-inline > .color-field {
    flex: 1 1 0dp;
    min-width: 0dp;
    width: 100%;
}

/* --- Select popup (RmlUi has no `selectoption` element: options are `option`
   inside `selectbox`, and the selected one carries :checked) --- */
.select-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 31px;
    box-sizing: border-box;
}

/* A standalone choice fills the same form column as string and numeric fields.
   Grouped choices already share their row equally with their peers. */
.field-row > .select-wrapper {
    width: 100%;
}

.select-wrapper.field-choice {
    gap: 7px;
    padding: 0px 8px 0px 10px;
    background-color: #111411;
    border: 2px #050706;
    border-radius: 4px;
}

.select-wrapper.field-choice:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.select-label {
    flex-shrink: 0;
    color: #eeeeee;
    font-size: 12px;
}

.select-wrapper > select {
    flex: 1 1 0dp;
    width: auto;
    min-width: 0dp;
}

.select-wrapper > .field-select {
    height: 27px;
    background-color: transparent;
    border-width: 0px;
    padding: 0px;
}

.select-arrow {
    width: 0px;
    height: 0px;
    flex: 0 0 0px;
    border-left: 5px transparent;
    border-right: 5px transparent;
    border-top: 6px #d4d8df;
    pointer-events: none;
}

selectvalue {
    background-color: transparent;
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    line-height: 27px;
    padding: 0px 3px;
    text-align: right;
}

selectbox {
    background-color: #0a0a0f;
    color: #ffffff;
    border: 2px #2e342f;
    margin-top: 2px;
    max-height: 200px;
    overflow-y: auto;
    z-index: 1000;
}

selectbox option {
    background-color: #111411;
    color: #ffffff;
    padding: 6px 10px;
    display: block;
    min-height: 24px;
}

selectbox option:hover,
selectbox option:focus {
    background-color: #202820;
}

selectbox option:checked {
    background-color: #1a2a3a;
    color: #8ab4ff;
}
