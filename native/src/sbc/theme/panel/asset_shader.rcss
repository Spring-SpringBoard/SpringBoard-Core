/* Asset shader panel: the map preview.
 *
 * The img needs an explicit width. Without one RmlUi lays the texture out at its
 * native size and wraps it, so a 1024px map became a grid of tiles rather than
 * one picture. */

div.asset-shader-preview
{
	display: block;
	margin: 6dp 0dp 2dp 0dp;
	padding: 4dp;
	background-color: #0f1a12;
	border: 1dp #2c4a33;
	text-align: center;
}

/* An absolute size, not a percentage: a percentage width resolves against a
 * parent that has no definite width here, and RmlUi then falls back to tiling
 * the texture across the box instead of scaling it. Maps are square. */
div.asset-shader-preview img
{
	display: block;
	width: 452dp;
	height: 452dp;
}

div.asset-shader-preview-path
{
	display: block;
	font-size: 11dp;
	color: #6f8a76;
	text-align: center;
	margin-bottom: 6dp;
}

div.asset-shader-preview-empty
{
	display: block;
	margin: 6dp 0dp;
	padding: 24dp;
	background-color: #0f1a12;
	border: 1dp #2c4a33;
	color: #6f8a76;
	text-align: center;
}
