/* Shared asset/material grid geometry and cells. */
.grid-container {
    border: 1px #555555;
    border-radius: 3px;
    background-color: #1a1a1a;
    overflow-y: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 5px;
    gap: 5px;
}

.grid-container.hidden {
    display: none;
}

#terrain-pattern-grid-picker,
#texture-pattern-grid-picker,
#metal-pattern-grid-picker,
#grass-pattern-grid-picker {
    margin-bottom: 12dp;
}

.grid-item {
    border: 1px #444444;
    border-radius: 2px;
    cursor: pointer;
    background-color: #2a2a2a;
    overflow: hidden;
}

.grid-item:hover {
    border-color: #777777;
}

.grid-item.selected {
    border-color: #3a7ebf;
}

/* Specificity keeps display:none from losing to flex/button rules. */
.field-composite-button.hidden,
.field-numeric-button.hidden,
.field-numeric-input.hidden,
.field-string-button.hidden,
.field-string-input.hidden,
.field-section.hidden,
.field-inline.hidden,
.field-group.hidden,
.field-input.hidden {
    display: none;
}
