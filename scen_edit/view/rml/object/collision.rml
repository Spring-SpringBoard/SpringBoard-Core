<rml>
<head>
    <title>Collision</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="collision" class="editor-panel">
    <div class="editor-header"><h2>Collision Volume</h2></div>
    <div class="editor-content">
        <div class="form-row"><label>Type:</label><select id="collision-type"><option>Box</option><option>Sphere</option><option>Cylinder</option></select></div>
        <div class="form-row"><label>Scale X:</label><input type="number" id="scale-x"/></div>
        <div class="form-row"><label>Scale Y:</label><input type="number" id="scale-y"/></div>
        <div class="form-row"><label>Scale Z:</label><input type="number" id="scale-z"/></div>
    </div>
</body>
</rml>
