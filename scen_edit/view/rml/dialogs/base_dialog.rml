<rml>
<head>
    <title>Dialog</title>
    <link type="text/rcss" href="../dialog.rcss"/>
</head>
<body id="base-dialog" class="dialog">
    <div class="dialog-header">
        <span class="dialog-title" id="dialog-title">Dialog</span>
        <button class="dialog-close" id="btn-close">×</button>
    </div>
    <div class="dialog-content" id="dialog-content">
        <!-- Content injected here -->
    </div>
    <div class="dialog-footer">
        <button id="btn-ok" class="dialog-button">OK</button>
        <button id="btn-cancel" class="dialog-button">Cancel</button>
    </div>
</body>
</rml>
