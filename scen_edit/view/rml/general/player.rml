<rml>
<head>
    <title>Player</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="player" class="editor-panel">
    <div class="editor-header"><h2>Player Settings</h2></div>
    <div class="editor-content">
        <div class="form-row"><label>Name:</label><input type="text" id="player-name" class="form-input"/></div>
        <div class="form-row"><label>Team:</label><input type="number" id="team" class="form-input"/></div>
        <div class="form-row"><label>Ally Team:</label><input type="number" id="ally-team" class="form-input"/></div>
    </div>
</body>
</rml>
