<rml>
<head>
    <title>Sky Editor</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="sky-editor" class="editor-panel">
    <div class="editor-header"><h2>Sky Settings</h2></div>
    <div class="editor-content">
        <div class="form-row"><label>Sky Color:</label><input type="color" id="sky-color"/></div>
        <div class="form-row"><label>Cloud Color:</label><input type="color" id="cloud-color"/></div>
        <div class="form-row"><label>Fog Start:</label><input type="number" id="fog-start"/></div>
        <div class="form-row"><label>Fog End:</label><input type="number" id="fog-end"/></div>
        <div class="form-row"><label>Fog Color:</label><input type="color" id="fog-color"/></div>
    </div>
</body>
</rml>
