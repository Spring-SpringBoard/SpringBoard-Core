<rml>
<head>
    <title>Water Editor</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="water-editor" class="editor-panel">
    <div class="editor-header"><h2>Water Settings</h2></div>
    <div class="editor-content">
        <div class="form-row"><label>Water Level:</label><input type="number" id="water-level" value="0"/></div>
        <div class="form-row"><label>Damage:</label><input type="number" id="damage" value="0"/></div>
        <div class="form-row"><label>Absorb Color:</label><input type="color" id="absorb-color"/></div>
        <div class="form-row"><label>Base Color:</label><input type="color" id="base-color"/></div>
        <div class="form-row"><label>Min Color:</label><input type="color" id="min-color"/></div>
    </div>
</body>
</rml>
