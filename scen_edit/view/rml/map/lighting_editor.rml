<rml>
<head>
    <title>Lighting Editor</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="lighting-editor" class="editor-panel">
    <div class="editor-header"><h2>Lighting Settings</h2></div>
    <div class="editor-content">
        <div class="form-row"><label>Ground Ambient:</label><input type="color" id="ground-ambient"/></div>
        <div class="form-row"><label>Ground Sun:</label><input type="color" id="ground-sun"/></div>
        <div class="form-row"><label>Unit Ambient:</label><input type="color" id="unit-ambient"/></div>
        <div class="form-row"><label>Unit Sun:</label><input type="color" id="unit-sun"/></div>
        <div class="form-row"><label>Sun Direction X:</label><input type="number" id="sun-dir-x"/></div>
        <div class="form-row"><label>Sun Direction Y:</label><input type="number" id="sun-dir-y"/></div>
        <div class="form-row"><label>Sun Direction Z:</label><input type="number" id="sun-dir-z"/></div>
    </div>
</body>
</rml>
