<rml>
<head>
    <title>Object Editor</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="object-editor" class="editor-panel">
    <div class="editor-header">
        <h2>Object Properties</h2>
        <div class="editor-toolbar">
            <button id="btn-apply" class="toolbar-button">Apply</button>
            <button id="btn-revert" class="toolbar-button">Revert</button>
        </div>
    </div>
    <div class="editor-content">
        <div class="property-grid">
            <!-- Object type selector -->
            <div class="form-row">
                <label>Type:</label>
                <select id="object-type" class="form-select">
                    <option value="unit">Unit</option>
                    <option value="feature">Feature</option>
                    <option value="area">Area</option>
                </select>
            </div>

            <!-- Position -->
            <div class="property-section">
                <h4>Position</h4>
                <div class="form-row">
                    <label>X:</label>
                    <input type="number" id="pos-x" class="form-input-number"/>
                </div>
                <div class="form-row">
                    <label>Y:</label>
                    <input type="number" id="pos-y" class="form-input-number"/>
                </div>
                <div class="form-row">
                    <label>Z:</label>
                    <input type="number" id="pos-z" class="form-input-number"/>
                </div>
            </div>

            <!-- Rotation -->
            <div class="property-section">
                <h4>Rotation</h4>
                <div class="form-row">
                    <label>Rotation:</label>
                    <input type="number" id="rotation" class="form-input-number" min="0" max="360"/>
                </div>
            </div>

            <!-- Team -->
            <div class="property-section">
                <h4>Team</h4>
                <div class="form-row">
                    <label>Team:</label>
                    <select id="object-team" class="form-select">
                        <!-- Teams populated dynamically -->
                    </select>
                </div>
            </div>

            <!-- Custom properties -->
            <div class="property-section">
                <h4>Properties</h4>
                <div id="custom-properties">
                    <!-- Properties populated dynamically based on object type -->
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
