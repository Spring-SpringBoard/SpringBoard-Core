<rml>
<head>
    <title>Area Editor</title>
    <link type="text/rcss" href="../editor.rcss"/>
</head>
<body id="area-view" class="editor-panel">
    <div class="editor-header"><h2>Area</h2></div>
    <div class="editor-content">
        <div class="form-row"><label>Name:</label><input type="text" id="area-name" class="form-input"/></div>
        <div class="form-row"><label>X:</label><input type="number" id="area-x"/></div>
        <div class="form-row"><label>Z:</label><input type="number" id="area-z"/></div>
        <div class="form-row"><label>Width:</label><input type="number" id="area-width"/></div>
        <div class="form-row"><label>Height:</label><input type="number" id="area-height"/></div>
    </div>
</body>
</rml>
