<rml>
<head>
    <title>Custom Trigger</title>
    <link type="text/rcss" href="../dialog.rcss"/>
</head>
<body id="custom-window" class="dialog large-dialog">
    <div class="dialog-header">
        <span class="dialog-title">Custom Trigger Code</span>
        <button class="dialog-close" id="btn-close">×</button>
    </div>
    <div class="dialog-content">
        <textarea id="custom-code" class="code-editor">-- Custom Lua code here</textarea>
    </div>
    <div class="dialog-footer">
        <button id="btn-ok" class="dialog-button primary">OK</button>
        <button id="btn-cancel" class="dialog-button">Cancel</button>
    </div>
</body>
</rml>
