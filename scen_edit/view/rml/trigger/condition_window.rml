<rml>
<head>
    <title>Edit Condition</title>
    <link type="text/rcss" href="../dialog.rcss"/>
</head>
<body id="condition-window" class="dialog">
    <div class="dialog-header">
        <span class="dialog-title">Edit Condition</span>
        <button class="dialog-close" id="btn-close">×</button>
    </div>
    <div class="dialog-content">
        <div class="form-row"><label>Condition Type:</label><select id="condition-type"></select></div>
        <div id="condition-fields" class="form-fields">
            <!-- Condition-specific fields populated dynamically -->
        </div>
    </div>
    <div class="dialog-footer">
        <button id="btn-ok" class="dialog-button primary">OK</button>
        <button id="btn-cancel" class="dialog-button">Cancel</button>
    </div>
</body>
</rml>
