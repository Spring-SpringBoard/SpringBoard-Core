<rml>
<head>
    <title>Edit Trigger</title>
    <link type="text/rcss" href="../dialog.rcss"/>
</head>
<body id="trigger-window" class="dialog large-dialog">
    <div class="dialog-header">
        <span class="dialog-title">Edit Trigger</span>
        <button class="dialog-close" id="btn-close">×</button>
    </div>
    <div class="dialog-content">
        <div class="form-row"><label>Name:</label><input type="text" id="trigger-name" class="form-input"/></div>
        <div class="form-row"><label>Enabled:</label><input type="checkbox" id="enabled" checked="checked"/></div>
        <div class="trigger-section">
            <h4>Events</h4>
            <div id="events-list" class="element-list"></div>
            <button id="btn-add-event" class="icon-button">+</button>
        </div>
        <div class="trigger-section">
            <h4>Conditions</h4>
            <div id="conditions-list" class="element-list"></div>
            <button id="btn-add-condition" class="icon-button">+</button>
        </div>
        <div class="trigger-section">
            <h4>Actions</h4>
            <div id="actions-list" class="element-list"></div>
            <button id="btn-add-action" class="icon-button">+</button>
        </div>
    </div>
    <div class="dialog-footer">
        <button id="btn-ok" class="dialog-button primary">OK</button>
        <button id="btn-cancel" class="dialog-button">Cancel</button>
    </div>
</body>
</rml>
