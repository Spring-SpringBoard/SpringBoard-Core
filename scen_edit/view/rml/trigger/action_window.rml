<rml>
<head>
    <title>Edit Action</title>
    <link type="text/rcss" href="../dialog.rcss"/>
</head>
<body id="action-window" class="dialog">
    <div class="dialog-header">
        <span class="dialog-title">Edit Action</span>
        <button class="dialog-close" id="btn-close">×</button>
    </div>
    <div class="dialog-content">
        <div class="form-row"><label>Action Type:</label><select id="action-type"></select></div>
        <div id="action-fields" class="form-fields">
            <!-- Action-specific fields populated dynamically -->
        </div>
    </div>
    <div class="dialog-footer">
        <button id="btn-ok" class="dialog-button primary">OK</button>
        <button id="btn-cancel" class="dialog-button">Cancel</button>
    </div>
</body>
</rml>
