<rml>
<head>
    <title>Status Window</title>
    <link rel="stylesheet" type="text/rcss" href="../common.css" />
    <link type="text/rcss" href="../../rcss/floating.rcss"/>
</head>
<body id="status-window" class="floating-panel" data-model="status_window">
    <!-- `data-rml` renders the bound string as markup (the memory line needs it
         for its colour span). `data-bind` is not an RmlUi data view, so the
         previous markup bound nothing and the window rendered empty. -->
    <div id="status-position" class="status-line" data-rml="position"></div>
    <div id="status-memory" class="status-line" data-rml="memory"></div>
    <div id="status-version" class="status-line" data-rml="version"></div>
</body>
</rml>
