body#springboard {
    font-family: Poppins;
    font-size: 14dp;
    color: #cccccc;
    position: absolute;
    right: 0dp;
    top: 0dp;
    width: 500dp;
    height: 100%;
    background-color: #1a1a1a;
}

/* Tab bar at top */
.tab-bar {
    position: absolute;
    top: 10dp;
    left: 0dp;
    right: 0dp;
    height: 25dp;
    background-color: #222222;
    display: flex;
    flex-direction: row;
    gap: 1dp;
    padding: 1dp;
}

.tab-button {
    flex: 1;
    background-color: #3a3a3a;
    color: #999999;
    border: 1dp #555555;
    padding: 3dp 8dp;
    text-align: center;
    font-size: 12dp;
    cursor: pointer;
}

.tab-button:hover {
    background-color: #4a4a4a;
    color: #cccccc;
}

.tab-button.active {
    background-color: #1a1a1a;
    color: #ffffff;
    border-bottom: 2dp #3a7ebf;
}

/* Editor button panel (scrollable horizontal) - matches TOOLBOX_ITEM_HEIGHT (70dp) + padding */
.editor-panel-wrapper {
    position: absolute;
    top: 40dp;
    left: 0dp;
    right: 0dp;
    height: 80dp;
    overflow-x: auto;
    overflow-y: hidden;
    background-color: #222222;
    border-bottom: 1dp #555555;
}

.editor-button-panel {
    display: flex;
    flex-direction: row;
    gap: 1dp;
    padding: 5dp;
    min-width: 100%;
}

.editor-button {
    width: 70dp;
    height: 70dp;
    background-color: #2a2a2a;
    border: 1dp #555555;
    border-radius: 3dp;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5dp;
    flex-shrink: 0;
}

.editor-button:hover {
    background-color: #3a3a3a;
    border-color: #888888;
}

.editor-button.pressed {
    background-color: #1a1a1a;
    border-color: #00ff00;
}

.editor-button img {
    width: 35dp;
    height: 35dp;
    margin-bottom: 3dp;
}

.editor-button-label {
    font-size: 9dp;
    color: #cccccc;
    text-align: center;
}

.editor-button.pressed .editor-button-label {
    color: #00ff00;
}

/* Main content area - starts after editor panel (40 + 80 = 120dp) */
.main-content {
    position: absolute;
    top: 125dp;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    background-color: #222222;
    padding: 10dp;
    color: #cccccc;
    overflow-y: auto;
}
