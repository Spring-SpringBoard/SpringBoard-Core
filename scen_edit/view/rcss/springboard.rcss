body#springboard {
    font-family: Poppins;
    font-size: 12px;
    color: #cccccc;
    position: absolute;
    right: 0px;
    top: 0px;
    width: 500px;
    height: 100%;
    background-color: #1f26219e;
}

/* Tab bar at top */
.tab-bar {
    position: absolute;
    top: 10px;
    left: 0px;
    right: 0px;
    height: 40px;
    background-color: #1c211e;
    display: flex;
    flex-direction: row;
    gap: 2px;
    padding: 0px 0px 0px 0px;
}

.tab-button {
    width: 70px;
    height: 40px;
    flex-shrink: 0;
    background-color: #111411;
    color: #999999;
    border-color: #555555;
    padding: 2px 6px;
    font-size: 12px;
    /* Centre the label. Do not use flex here: RmlUi will not render the raw
       text node inside a flex container. */
    text-align: center;
    line-height: 36px;
}

.tab-button:hover {
    background-color: #202820;
    color: #cccccc;
}

.tab-button.active {
    background-color: #050705;
    color: #ffffff;
    border-color: #5d7190;
}

/* Action bar (Save, Load, etc.) */
.action-bar {
    position: absolute;
    top: 130px;
    left: 0px;
    right: 0px;
    height: 40px;
    background-color: transparent;
    border-bottom: 0px transparent;
    display: flex;
    flex-direction: row;
    gap: 1px;
    padding: 0px 5px;
    align-items: center;
}

.toolbar-action-button {
    width: 40px;
    height: 40px;
    background-color: #111411;
    border-color: #2e342f;
    padding: 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.toolbar-action-button:hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.toolbar-action-button img {
    width: 20px;
    height: 20px;
}

/* Editor button panel (scrollable horizontal) - smaller buttons */
.editor-panel-wrapper {
    position: absolute;
    top: 55px;
    left: 0px;
    right: 0px;
    height: 80px;
    overflow-x: auto;
    overflow-y: hidden;
    background-color: transparent;
    border-bottom: 0px transparent;
}

.editor-button-panel {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 1dp;
    padding: 5px 5px 5px 5px;
    min-width: 100%;
}

.editor-button {
    width: 70px;
    height: 70px;
    background-color: #111411;
    border-color: #2e342f;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3px;
    flex-shrink: 0;
}

.editor-button:hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.editor-button.pressed {
    background-color: #050705;
    border-color: #00ff00;
}

.editor-button img {
    width: 35px;
    height: 35px;
    margin-bottom: 4px;
}

.editor-button-label {
    font-size: 11px;
    color: #cccccc;
    text-align: center;
}

.editor-button.pressed .editor-button-label {
    color: #00ff00;
}

/* Main content area - starts after editor panel (40 tab + 45 action + 60 editor = 145dp + 10 margin) */
.main-content {
    position: absolute;
    top: 175px;
    left: 0px;
    right: 0px;
    bottom: 0px;
    background-color: #1f26219e;
    padding: 0px 10px 0px 10px;
    color: #cccccc;
    overflow-y: auto;
}

/* Editor field styles */
.editor-container {
    padding: 0px 10px 10px 10px;
}

.editor-title {
    font-size: 16px;
    color: #ffffff;
    margin-bottom: 15dp;
    padding-bottom: 5dp;
    border-bottom: 1px #555555;
}

/* Action buttons panel at top of editor */
.action-buttons-panel {
    display: flex;
    flex-direction: row;
    gap: 2px;
    margin-bottom: 15dp;
    padding: 5px 5px 5px 5px;
    background-color: #2a2a2a;
    border-bottom: 1px #555555;
}

.action-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    background-color: #111411;
    border-color: #2e342f;
    padding: 3px;
    margin-right: 0px;
}

.action-button:disabled,
.action-button.disabled {
    background-color: #1a1a1a;
    border-color: #333333;
    color: #777777;
    cursor: default;
}

.action-button:disabled:hover,
.action-button.disabled:hover {
    background-color: #1a1a1a;
    border-color: #333333;
}

.action-button:not(.disabled):not(:disabled):hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.action-button.pressed {
    background-color: #050705;
    border-color: #00ff00;
}

.action-button-icon,
.action-button img {
    width: 32px;
    height: 32px;
    margin-bottom: 4px;
}

.action-button-label {
    font-size: 11px;
    color: #cccccc;
    text-align: center;
}

.action-button.pressed .action-button-label {
    color: #00ff00;
}

.field-separator {
    height: 1px;
    background-color: #555555;
    margin: 15px 0px;
}

.field-group {
    display: flex;
    flex-direction: row;
    /* Wrap instead of clipping: grouped numeric fields (X/Y/Z) can be wider
       than the 500px panel and the last column was cut off. */
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
    align-items: center;
}

/* Grid View styles */
.grid-container {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 5dp;
    padding: 5px;
    overflow-y: auto;
    align-content: flex-start;
    height: 300px;
}

.grid-item {
    background-color: #2a2a2a;
    border: 1dp #555555;
    border-radius: 3dp;
    cursor: pointer;
    display: block;
    padding: 0;
    overflow: hidden;
}

.grid-item:hover {
    background-color: #3a3a3a;
    border-color: #777777;
}

.grid-item.selected {
    background-color: #1a3a5a;
    border-color: #3a7ebf;
}

.grid-item.hidden {
    display: none;
}

/* Box that holds the thumbnail. Sized inline from itemWidth/itemHeight. */
.grid-item-image-box {
    display: block;
    overflow: hidden;
}

.grid-item-image {
    display: block;
    margin: auto;
}

/* Normal flow, directly under the image box. Absolute positioning is not used:
   RmlUi did not treat the cell as a containing block, so the label escaped the
   grid and rendered at the bottom of the enclosing dialog. */
.grid-item-label {
    display: block;
    font-size: 9dp;
    color: #dddddd;
    text-align: center;
    padding: 1dp 2dp;
    overflow: hidden;
    white-space: nowrap;
}

/* Filter Panel styles */
.filter-panel {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 15px;
    padding: 10px;
    background-color: #2a2a2a;
    border-bottom: 1px #555555;
    align-items: center;
}

.filter-label {
    color: #cccccc;
    font-size: 12px;
    margin-right: 5px;
}

.filter-combo {
    background-color: #3a3a3a;
    color: #ffffff;
    border: 1px #555555;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
    min-width: 90px;
    cursor: pointer;
}

.filter-combo:hover {
    background-color: #4a4a4a;
    border-color: #777777;
}

.filter-combo:focus {
    border-color: #3a7ebf;
}

/* Dropdown (select) element styling */
select {
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    border-radius: 2px;
    padding: 3px 7px;
    font-size: 12px;
    min-height: 26px;
    cursor: pointer;
}

.select-wrapper:hover select,
select:hover {
    background-color: #202820;
    border-color: #6f806d;
}

select:focus {
    border-color: #5d7190;
}

/* Dropdown value (the clickable part) */
selectvalue {
    background-color: transparent;
    color: #ffffff;
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    padding-right: 20px;
}

/* Select wrapper to position arrow */
.select-wrapper {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 26px;
}

.select-wrapper select {
    width: 100%;
}

/* Dropdown arrow */
.select-arrow {
    width: 16px;
    margin-left: -16px;
    color: #ffffff;
    font-size: 12px;
    text-align: center;
    pointer-events: none;
}

/* Dropdown box (the popup containing options) */
selectbox {
    background-color: #0a0a0a;
    color: #ffffff;
    border: 1px #666666;
    border-radius: 3px;
    padding: 0;
    margin-top: 2px;
    max-height: 300px;
    overflow-y: auto;
    z-index: 1000;
}

/* Individual dropdown options. RmlUi builds the popup from real <option>
   elements inside <selectbox> -- there is no `selectoption` element, so the
   old rules matched nothing (no padding, no hover feedback). */
selectbox option {
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 6px 10px;
    cursor: pointer;
    display: block;
    margin: 0;
    border: 1px transparent;
    min-height: 24px;
    line-height: 24px;
}

selectbox option:hover {
    background-color: #3a7ebf;
    color: #ffffff;
    border-color: #5a9edf;
}

/* RmlUi marks the current option with the :checked pseudo class. */
selectbox option:checked {
    background-color: #2a4a6a;
    color: #ffffff;
}

selectbox option:checked:hover {
    background-color: #3a7ebf;
}

.filter-edit {
    background-color: #3a3a3a;
    color: #ffffff;
    border: 1dp #555555;
    border-radius: 3dp;
    padding: 4dp 8dp;
    font-size: 12dp;
    min-width: 90dp;
}

.filter-edit:hover {
    border-color: #777777;
}

.filter-edit:focus {
    border-color: #3a7ebf;
}

/* Path Navigation styles */
.path-navigation {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
    padding: 10dp;
    background-color: #2a2a2a;
    border-bottom: 1dp #555555;
}

.path-up-button {
    width: 24dp;
    height: 24dp;
    background-color: #3a3a3a;
    border-color: #555555;
    border-radius: 3dp;
    padding: 2dp;
}

.path-up-button:hover {
    background-color: #4a4a4a;
    border-color: #777777;
}

.path-up-button img {
    width: 100%;
    height: 100%;
}

.path-label {
    color: #cccccc;
    font-size: 12dp;
    flex: 1;
}

.path-root-label {
    color: #999999;
    font-size: 11dp;
    margin-left: auto;
}

/* Add Brush Button styles (for SavedBrushes) */
.add-brush-button {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5dp;
}

.add-brush-button:hover {
    background-color: #202820;
}

.add-brush-icon {
    width: 35dp;
    height: 35dp;
    margin-bottom: 3dp;
}

.add-brush-label {
    font-size: 10dp;
    color: #cccccc;
    text-align: center;
}

/* Remove Brush Button styles (X button on brush items) */
.remove-brush-button {
    position: absolute;
    width: 20dp;
    height: 20dp;
    right: 0dp;
    top: 0dp;
    background-color: #cc3333;
    border-color: #aa2222;
    border-radius: 3dp;
    padding: 2dp;
    z-index: 10;
}

.remove-brush-button:hover {
    background-color: #dd4444;
    border-color: #bb3333;
}

.remove-brush-button img {
    width: 100%;
    height: 100%;
}

/* No background for special items (like add button) */
.grid-item.no-background {
    background-color: transparent;
    border: 1dp #555555;
}

.grid-item.no-background:hover {
    background-color: #2a2a2a;
}

.grid-item.no-background.selected {
    background-color: transparent;
    border-color: #555555;
}

/* Editor custom content (e.g. the teams list) */
.editor-custom-content {
    display: block;
    margin-top: 6dp;
}

.team-list-header {
    color: #d7d7d7;
    font-size: 12dp;
    margin-bottom: 6dp;
}

.team-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    padding: 4dp 6dp;
    margin-bottom: 4dp;
    background-color: #1a1a1a;
    border: 1dp #3a3a3a;
    border-radius: 3dp;
}

.team-row:hover {
    border-color: #5a5a5a;
}

.team-swatch {
    width: 16dp;
    height: 16dp;
    flex-shrink: 0;
    border: 1dp #050706;
    border-radius: 2dp;
}

.team-name {
    flex: 1;
    color: #eeeeee;
    font-size: 12dp;
}

.team-edit,
.team-remove {
    flex-shrink: 0;
    height: 24dp;
    padding: 0dp 10dp;
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1dp #555555;
    border-radius: 3dp;
    cursor: pointer;
    text-align: center;
    line-height: 22dp;
}

.team-edit:hover {
    background-color: #3a7ebf;
    border-color: #5a9edf;
}

.team-remove {
    width: 24dp;
    padding: 0dp;
}

.team-remove:hover {
    background-color: #a33;
    border-color: #d55;
}
