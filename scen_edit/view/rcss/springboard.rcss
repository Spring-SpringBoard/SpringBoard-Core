body#springboard {
    font-family: Liberation Sans;
    font-size: 14dp;
    color: #cccccc;
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
}

.menu-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 30dp;
    background-color: #2a2a2a;
    padding: 5dp;
    display: flex;
    flex-direction: row;
    gap: 5dp;
}

.menu-button {
    background-color: #3a3a3a;
    color: #cccccc;
    border: 1dp #555555;
    padding: 5dp 15dp;
    border-radius: 3dp;
}

.menu-button:hover {
    background-color: #4a4a4a;
}

.menu-button:active {
    background-color: #555555;
}

.team-selector {
    position: absolute;
    top: 40dp;
    right: 10dp;
    padding: 5dp;
    background-color: #2a2a2a;
    border: 1dp #555555;
    border-radius: 3dp;
    display: flex;
    flex-direction: row;
    gap: 5dp;
    align-items: center;
}

.team-selector label {
    color: #cccccc;
}

.team-selector select {
    background-color: #3a3a3a;
    color: #cccccc;
    border: 1dp #555555;
    padding: 3dp;
}

.main-content {
    position: absolute;
    top: 80dp;
    left: 10dp;
    right: 10dp;
    bottom: 50dp;
    background-color: #222222;
    border: 1dp #555555;
    border-radius: 3dp;
    display: flex;
    flex-direction: column;
}

.tab-bar {
    height: 30dp;
    background-color: #2a2a2a;
    border-bottom: 1dp #555555;
    display: flex;
    flex-direction: row;
}

.tab-content {
    flex-grow: 1;
    padding: 10dp;
    color: #cccccc;
}

.bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40dp;
    background-color: #2a2a2a;
    border-top: 1dp #555555;
    padding: 5dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.bottom-bar span {
    color: #cccccc;
    padding-left: 10dp;
}

.control-button {
    background-color: #3a3a3a;
    color: #cccccc;
    border: 1dp #555555;
    padding: 5dp 20dp;
    border-radius: 3dp;
    margin-left: 5dp;
}

.control-button:hover {
    background-color: #4a4a4a;
}

.control-button:active {
    background-color: #555555;
}
