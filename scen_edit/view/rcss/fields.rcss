/* Common Field Styles - used across dialogs, editors, and floating windows */

.field-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    gap: 10px;
    min-height: 31px;
}

.field-row.hidden {
    display: none;
}

.hidden {
    display: none;
}

.field-inline {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 7px;
}

/* Size to the label text: a fixed 44px clipped longer captions ("Emission"). */
.field-inline .field-label {
    width: auto;
    min-width: 44px;
    margin-right: 4px;
    flex-shrink: 0;
    color: #cccccc;
    font-size: 12px;
}

.field-inline .field-input {
    width: 66px;
    height: 26px;
    flex-shrink: 0;
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    padding: 3px 6px;
    font-size: 12px;
}

.field-label {
    width: 112px;
    flex-shrink: 0;
    color: #cccccc;
    font-size: 12px;
}

.field-input {
    width: 126px;
    height: 26px;
    flex-shrink: 0;
    background-color: #111411;
    color: #ffffff;
    border: 1px #2e342f;
    padding: 3px 6px;
    font-size: 12px;
}

.field-input:focus {
    border-color: #5d7190;
    background-color: #151a16;
}

.field-checkbox {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 6px;
    cursor: pointer;
    background-color: #3a3a3a;
    border: 1px #555555;
    border-radius: 3px;
}

.field-checkbox:hover {
    border-color: #8a8a8a;
}

.field-checkbox:checked {
    background-color: #3a7ebf;
    border-color: #2a5f8f;
}

.field-button {
    width: 110px;
    min-height: 26px;
    flex-shrink: 0;
    background-color: #3a7ebf;
    color: #ffffff;
    border-color: #2a5f8f;
    padding: 3px 7px;
    font-size: 12px;
}

.field-button:hover {
    background-color: #4a8ecf;
}

.field-button:active {
    background-color: #3a7ebf;
    border-color: #2a5f8f;
}

.field-color-button {
    width: 140px;
    height: 31px;
    flex-shrink: 0;
    color: #ffffff;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 5px;
    font-size: 12px;
}

.field-color-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-color-button:active {
    border-color: #999999;
}

.field-numeric-button,
.field-numeric-input {
    background-color: #111411;
    border: 2px #050706;
    border-radius: 4px;
    color: #ffffff;
}

.field-numeric-button {
    height: 31px;
    padding: 0px 8px;
}

.field-numeric-button:hover {
    background-color: #202820;
    border-color: #4d5a50;
}

.field-numeric-button:active,
.field-numeric-button.dragging {
    color: #f5d316;
    border-color: #b19c24;
    background-color: #171a12;
}

.field-numeric-input {
    padding: 3px 8px;
    text-align: right;
}

.field-composite-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background-color: #111411;
    color: #eeeeee;
    border: 2px #050706;
    border-radius: 4px;
    padding: 0px 8px;
    min-height: 31px;
}

.field-composite-button:hover {
    background-color: #1d241f;
    border-color: #4f5c52;
}

.field-button-title {
    color: #eeeeee;
    font-size: 12px;
    text-align: left;
}

.field-button-value {
    color: #d9d9d9;
    font-size: 12px;
    text-align: right;
}

.field-swatch {
    width: 18px;
    height: 18px;
    border: 2px #050706;
    flex-shrink: 0;
}

.field-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin: 10px 0px 7px 0px;
}

.field-section-label {
    color: #d7d7d7;
    font-size: 12px;
    flex-shrink: 0;
}

.field-section-line {
    width: 100px;
    height: 1px;
    background-color: #377987;
}

/* Grid Container - for asset/material browsers */
.grid-container {
    border: 1px #555555;
    border-radius: 3px;
    background-color: #1a1a1a;
    overflow-y: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 5px;
    gap: 5px;
}

.grid-container.hidden {
    display: none;
}

/* Grid Item. Width/height come from the renderer (itemWidth/itemHeight) as
   inline styles; the cell itself is image box + label in normal flow. */
.grid-item {
    border: 1px #444444;
    border-radius: 2px;
    cursor: pointer;
    background-color: #2a2a2a;
    overflow: hidden;
}

.grid-item:hover {
    border-color: #777777;
}

/* Colour only: changing border-width on selection resizes the cell and
   reflows/shifts the whole grid. */
.grid-item.selected {
    border-color: #3a7ebf;
}

/* RCSS has no !important, and `.hidden` (one class) ties with the rules above
   that set `display` (e.g. .field-composite-button { display: flex }), which
   then win by declaration order. These compound selectors raise specificity so
   hiding actually hides -- notably the numeric field's button, which otherwise
   stays visible next to its edit box. */
.field-composite-button.hidden,
.field-numeric-button.hidden,
.field-numeric-input.hidden,
.field-input.hidden {
    display: none;
}
